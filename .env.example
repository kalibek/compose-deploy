# Copy to .env and fill in. Generate strong values with:
#   openssl rand -hex 32

# Password for the web UI (single admin user).
ADMIN_PASSWORD=change-me

# Encrypts stored tokens/env/registry passwords and signs sessions.
# Keep it stable: changing it makes stored secrets undecryptable.
APP_SECRET=replace-with-openssl-rand-hex-32

# Optional
# DOCKER_SOCK=/var/run/docker.sock   # Podman rootless: /run/user/<uid>/podman/podman.sock (see README)
# DOCKER_COMMAND=docker   # CLI binary used for compose/ps/logs/exec, e.g. podman
# POLL_INTERVAL=60s
# COOKIE_SECURE=true   # when served over HTTPS
# TRUST_PROXY=true     # only behind a reverse proxy that sets X-Forwarded-For
